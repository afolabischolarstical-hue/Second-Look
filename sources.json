    { "id": "google_news",   "name": "Google News",                   "domains": ["news.google.com"], "search": "https://news.google.com/search?q={q}" },

    { "id": "pesacheck",     "name": "PesaCheck",                     "region": "East Africa",          "domains": ["pesacheck.org"] },
