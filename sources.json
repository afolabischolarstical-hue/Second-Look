{
  "_help": "The trusted sources Second Look may point people to. To add one, copy an entry and change it. 'domains' is the source's own website (used to check links). 'search' is an optional search page address where {q} is replaced by the search words; without it we use a Google search limited to the first domain. 'imageOnly' marks reverse image search tools. Confirm each source is still active before launch.",
  "sources": [
    { "id": "dubawa",        "name": "Dubawa",                        "region": "Nigeria and West Africa",              "domains": ["dubawa.org"] },
