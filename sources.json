    { "id": "bbc",           "name": "BBC News",                      "domains": ["bbc.co.uk", "bbc.com"], "search": "https://www.bbc.co.uk/search?q={q}" },
    { "id": "who",           "name": "World Health Organization",     "domains": ["who.int"] },
    { "id": "cdc",           "name": "CDC",                           "domains": ["cdc.gov"] },
    { "id": "nasa",          "name": "NASA",                          "domains": ["nasa.gov"] },
